void drawTextFrame(const Cue& c,uint32_t at){
 float in=ease((at-c.start)/560.0);float out=ease((c.end-at)/550.0);float alpha=in<out?in:out;
 int group=0;if(c.lyric==0)group=c.effect==1?1:0;if(c.lyric==1)group=c.effect==1?3:2;if(c.lyric==2)group=4;if(c.lyric==3)group=5;if(c.lyric==4)group=6;if(c.lyric==5)group=7;
 int stage=(int)(in*8);if(stage>8)stage=8;int n=group*9+stage;int v=(int)(alpha*255);
 tft.drawBitmap(px[n],py[n],sprites[n],pw[n],ph[n],rgb(v,v,v));
 if(c.lyric==4&&alpha>.25)rose((160-118)/2+118+3,(128-21)/2-1);
 if(c.lyric==5&&alpha>.25)heart(140,(128-17)/2-1);
}
// =======================================
// RENDER FRAME
// =======================================

void render(uint32_t at) {

  tft.fillScreen(ILI9341_BLACK);

  for (int i = 0; i < CUES; i++) {

    if (at >= cues[i].start &&
        at < cues[i].end) {

      drawTextFrame(cues[i], at);
      break;
    }
  }

  // Ending screen
  if (at >= 43000 && at < CLIP_END) {

    tft.setTextColor(
      rgb(235, 235, 235)
    );

    tft.setTextSize(2);
    tft.setCursor(118, 114);
    tft.print("music....");
  }


}


void setup(){Serial.begin(115200);pinMode(SYNC_PIN,INPUT_PULLUP);SPI.begin(12,13,11,CS);tft.begin();tft.setRotation(1);tft.fillScreen(ILI9341_BLACK);origin=millis();Serial.println("Bengali Lyrics Animation Ready - N16R8 / ILI9341");}
void loop() {

  uint32_t now = millis();

  bool button =
    digitalRead(SYNC_PIN);

  if (
    priorButton == HIGH &&
    button == LOW &&
    (now - lastButton) > 200
  ) {

    origin = now;
    lastButton = now;

    Serial.println(
      "Animation restarted"
    );
  }

  priorButton = button;

  while (Serial.available()) {

    if (Serial.read() == 's') {
      origin = now;

      Serial.println(
        "Serial synchronization"
      );
    }
  }

  uint32_t at = now - origin;

  if (at >= CLIP_END && REPEAT) {
    origin = now;
    at = 0;
  }

  if (
    now - lastFrame >= FRAME_INTERVAL
  ) {

    lastFrame = now;
    render(at);
  }
  delay(5);
}
