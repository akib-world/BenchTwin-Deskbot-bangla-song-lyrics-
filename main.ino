// =======================================

void heart(int x, int y) {

  uint16_t peach =
    rgb(207, 126, 103);

  circle(
    x + 4, y + 5, 5, peach
  );

  circle(
    x + 12, y + 5, 5, peach
  );

  triangle(
    x - 1, y + 7,
    x + 17, y + 7,
    x + 8, y + 18,
    peach
  );
}

