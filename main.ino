// =======================================

void rose(int x, int y) {

  line(
    x + 5, y + 7,
    x + 2, y + 18,
    rgb(63, 130, 45)
  );

  line(
    x + 4, y + 13,
    x - 1, y + 10,
    rgb(84, 150, 55)
  );

  line(
    x + 4, y + 14,
    x + 9, y + 12,
    rgb(69, 150, 50)
  );

  circle(
    x + 4, y + 5, 4,
    rgb(159, 19, 39)
  );

  circle(
    x + 6, y + 4, 3,
    rgb(214, 28, 51)
  );

  pixel(
    x + 5, y + 3,
    rgb(255, 98, 105)
  );
}

