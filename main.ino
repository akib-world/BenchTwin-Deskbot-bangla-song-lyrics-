float clamped(float v) {
  return v < 0 ? 0 : v > 1 ? 1 : v;
}

float ease(float v) {
  v = clamped(v);
  return v * v * (3 - 2 * v);
}

uint16_t rgb(
  uint8_t r,
  uint8_t g,
  uint8_t b
) {
  return ((r & 248) << 8) |
         ((g & 252) << 3) |
         (b >> 3);
}

void pixel(int x,int y,uint16_t c){if(x>=0&&x<W&&y>=0&&y<H)tft.fillRect(x*2,y*2-8,2,2,c);}
void line(int x,int y,int a,int b,uint16_t c){tft.drawLine(x*2,y*2-8,a*2,b*2-8,c);}
void circle(int x,int y,int r,uint16_t c){tft.fillCircle(x*2,y*2-8,r*2,c);}
void triangle(int x,int y,int a,int b,int d,int e,uint16_t c){tft.fillTriangle(x*2,y*2-8,a*2,b*2-8,d*2,e*2-8,c);}
