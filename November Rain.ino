      lineText("AND IT'S HARD TO",0,3);
      lineText("HOLD A CANDLE",1,3);
      lineText("IN THE COLD NOVEMBER RAIN",2,3);
      break;
    case 4:
      lineText("WE'VE BEEN THROUGH THIS",0,4);
      lineText("SUCH A LONG, LONG TIME",1,4);
      lineText("JUST TRYNA KILL THE PAIN,",2,4);
      lineText("OOH YEAH",3,4);
      break;
    case 5:
      lineText("BUT LOVERS ALWAYS COME",0,2);
      lineText("AND LOVERS ALWAYS GO",1,2);
      break;
    case 6:
      lineText("AND NO ONE'S REALLY SURE",0,3);
      lineText("WHO'S LETTIN' GO TODAY,",1,3);
      lineText("WALKIN' AWAY",2,3);
      break;
    case 7:
      lineText("IF WE COULD TAKE THE",0,3);
      lineText("TIME TO LAY IT",1,3);
      lineText("ON THE LINE",2,3);
      break;
    case 8:
      lineText("I COULD REST MY HEAD,",0,3);
      lineText("JUST KNOWIN' THAT YOU",1,3);
      lineText("WERE MINE, ALL MINE",2,3);
      break;
    case 9:
      lineText("SO, IF YOU WANT",0,4);
      lineText("TO LOVE ME",1,4);
      lineText("THEN, DARLIN',",2,4);
      lineText("DON'T REFRAIN",3,4);
      break;
    case 10:
      lineText("OR I'LL JUST END UP",0,3);
      lineText("WALKIN' IN THE COLD",1,3);
      lineText("NOVEMBER RAIN",2,3);
      break;
    case 11:
      lineText("DO YOU NEED SOME TIME",0,4);
      lineText("ON YOUR OWN?",1,4);
      lineText("DO YOU NEED SOME TIME",2,4);
      lineText("ALL ALONE?",3,4);
      break;
  }
}
// The upper backdrop rows are solid across the width.
uint16_t skyColors[128];
constexpr int SPARK_COUNT = 18;
int16_t sparkX[SPARK_COUNT], sparkY[SPARK_COUNT];
bool trailVisible = false;
unsigned long lastTrailFrame = 0;

void clearTrail() {
  if (!trailVisible) return;
  for (int i = 0; i < SPARK_COUNT; ++i) {
    tft.drawPixel(sparkX[i], sparkY[i], skyColors[sparkY[i]]);
  }
  trailVisible = false;
}

void drawTrail(unsigned long elapsed) {
  clearTrail();
  const float phase = (elapsed % 2400) / 2400.0f;
  for (int i = 0; i < SPARK_COUNT; ++i) {
    const float angle = 6.2831853f * (phase - i * 0.007f);
    const float sine = sinf(angle);
    sparkX[i] = 80 + (int)(40.0f * sine * sine * sine);
    sparkY[i] = 49 - (int)(2.0f * (13.0f * cosf(angle)
        - 5.0f * cosf(2.0f * angle) - 2.0f * cosf(3.0f * angle)
        - cosf(4.0f * angle)));
    const uint16_t color = i < 6 ? ST77XX_WHITE : tft.color565(247, 189, 246);
    tft.drawPixel(sparkX[i], sparkY[i], color);

  }
  trailVisible = true;
}

void setup() {
  Serial.begin(115200);
  pinMode(SYNC_PIN, INPUT_PULLUP);
  SPI.begin(18, -1, 23, CS);
  tft.initR(TFT_TAB);
  tft.setSPISpeed(27000000);
  tft.setRotation(1);
  screenW=tft.width(); screenH=tft.height();
  fontScale=screenW/160;
  if(fontScale<1) fontScale=1;
  tft.setTextWrap(false);
  for (size_t i = 0; i < sizeof(backdrop) / sizeof(backdrop[0]); i += 4) {
    const int row = backdrop[i+1];
    if (row >= 94) break;
    for (int y = row * screenH / 120; y < (row + 1) * screenH / 120; ++y) {
      skyColors[y] = backdrop[i+3];
    }
  }
  background(false);
  epoch=millis();
}
void loop() {
  const unsigned long now = millis();
  const bool button = digitalRead(SYNC_PIN);
  if (previousButton == HIGH && button == LOW && now - lastRestart >= 200) {
    epoch = now;
    lastRestart = now;
  }
  previousButton = button;
  while (Serial.available()) {
    if (Serial.read() == 's') epoch = now;
  }
  unsigned long elapsed = (now - epoch) % CLIP_MS;
  int cue=-1;
  for(int i=0;i<COUNT;i++) {
    if(elapsed>=starts[i] && elapsed<ends[i]) cue=i;
  }
  // Paint only on cue changes: no full-screen clear/redraw every loop.
  if (cue != lastCue) {
    clearTrail();
    drawCue(cue);
    lastCue = cue;
  }
  if (cue == -1 && now - lastTrailFrame >= 40) {
    drawTrail(elapsed);
    lastTrailFrame = now;
  }
  delay(10);
}
